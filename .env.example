# Example environment for examples/it_helpdesk_server.py.
# Copy to .env and load it with: set -a; source .env; set +a
# Never commit real values; use a secret manager in production.

# Vertex AI project (authenticate locally with: gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=my-gcp-project

# 32+ byte random secrets, e.g. generated with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SUTRA_CONFIRMATION_SECRET=
SUTRA_SUBJECT_HASH_KEY=

# JWT verification (provide exactly one of SUTRA_JWKS_URL or SUTRA_JWT_KEY)
SUTRA_JWT_ISSUER=https://issuer.example.com
SUTRA_JWT_AUDIENCE=it-desk-app
SUTRA_JWT_ALGORITHMS=RS256,ES256
SUTRA_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# Dev only, instead of SUTRA_JWKS_URL: HS256 shared secret (32+ bytes) with SUTRA_JWT_ALGORITHMS=HS256
# SUTRA_JWT_KEY=

# Telemetry backend: otel or noop
SUTRA_TELEMETRY_BACKEND=otel
SUTRA_TELEMETRY_SERVICE_NAME=it-helpdesk
SUTRA_TELEMETRY_SERVICE_VERSION=dev
SUTRA_DEPLOYMENT_ENVIRONMENT=dev

HOST=127.0.0.1
PORT=8080
